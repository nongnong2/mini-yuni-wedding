rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function docPath(col, id) { return /databases/$(db)/documents/$(col)/$(id); }

    // 축하 글: 누구나 읽기(한 번에 100개까지), 형식이 맞을 때만 쓰기, 수정 불가
    match /messages/{id} {
      allow get: if true;
      allow list: if request.query.limit <= 100;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'avatar', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() >= 1 && request.resource.data.name.size() <= 10
        && request.resource.data.text is string
        && request.resource.data.text.trim().size() >= 1 && request.resource.data.text.size() <= 200
        && request.resource.data.avatar in ['man', 'woman']
        && request.resource.data.createdAt == request.time
        && !exists(docPath('secrets', id)) && existsAfter(docPath('secrets', id));
      // 같은 묶음에 비밀번호가 맞는 삭제 요청이 있을 때만 삭제
      allow delete: if !exists(docPath('deletions', id)) && existsAfter(docPath('deletions', id));
    }

    // 비밀번호 해시: 아무도 읽을 수 없고, 글과 함께일 때만 만들 수 있음
    match /secrets/{id} {
      allow create: if request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash is string
        && request.resource.data.hash.matches('^[0-9a-f]{64}$')
        && !exists(docPath('messages', id)) && existsAfter(docPath('messages', id));
    }

    // 삭제 요청: 해시가 같을 때만 만들 수 있음
    match /deletions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['hash'])
        && request.resource.data.hash == get(docPath('secrets', id)).data.hash
        && !existsAfter(docPath('messages', id));
    }
  }
}
